# ─────────────────────────────────────────────────────────────
# Pulse — Backend B (FastAPI)   ·   Variables de entorno
# Copiá este archivo a `.env` y ajustá los valores.
# ─────────────────────────────────────────────────────────────

# App
PORT=8000
NODE_ENV=development

# ── PostgreSQL ──────────────────────────────────────────────
# Los valores por defecto coinciden con docker-compose.yml de la raíz
# (POSTGRES_USER/PASSWORD/DB => "pulse"). El contenedor NO crea una base
# llamada "pulse_db"; si necesitás ese nombre, creála y ajustá DB_NAME:
#   docker exec pulse_postgres createdb -U pulse pulse_db
#   docker exec -i pulse_postgres psql -U pulse -d pulse_db < ../init.sql
DB_HOST=localhost
DB_PORT=5432
DB_USER=pulse
DB_PASSWORD=pulse
DB_NAME=pulse

# ── JWT ─────────────────────────────────────────────────────
# Mismo secreto/algoritmo que el Backend A (NestJS) para tokens intercambiables.
JWT_SECRET=dev-only-change-me-please-use-a-long-random-string
JWT_EXPIRES_IN_SECONDS=3600
JWT_ALGORITHM=HS256

# ── Argon2id (perfil OWASP · ver openapi.yaml) ──────────────
# memory_cost en KiB (19456 KiB = 19 MiB), time_cost = iteraciones, parallelism = hilos
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
