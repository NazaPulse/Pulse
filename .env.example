# ─────────────────────────────────────────────────────────────
# Pulse — Variables de entorno de docker-compose.yml (raíz)
# Copiá este archivo a `.env` y completá los valores. `.env` NO se versiona.
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL (servicio `db`; los backends reciben los mismos valores) ──
POSTGRES_USER=pulse
POSTGRES_DB=pulse
# Completalo con una contraseña propia.
POSTGRES_PASSWORD=

# ── JWT (compartido por ambos backends) ─────────────────────
# Valor largo y aleatorio, p. ej.: openssl rand -hex 32
JWT_SECRET=
# Backend Node usa formato con unidad; Backend Python, segundos.
JWT_EXPIRES_IN=3600s
JWT_EXPIRES_IN_SECONDS=3600

# ── Argon2id (perfil OWASP · ver openapi.yaml) ──────────────
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# ── Gateway y puertos publicados en el host ─────────────────
PROXY_PORT=80
PROXY_VUE_PORT=8080
DB_HOST_PORT=5432

# ── Backend que consume cada frontend (prefijos del gateway) ─
#  /api/node (= /api/v1) -> NestJS · /api/python (= /api/v2) -> FastAPI
REACT_API_BASE_URL=/api/node
VUE_API_BASE_URL=/api/python
