# ─────────────────────────────────────────────────────────────
# Pulse — Backend A (NestJS)   ·   Variables de entorno
# Copiá este archivo a `.env` y ajustá los valores.
# ─────────────────────────────────────────────────────────────

# App
PORT=3000
NODE_ENV=development

# ── PostgreSQL ──────────────────────────────────────────────
# Host, puerto, usuario y base coinciden con docker-compose.yml de la raíz.
# DB_PASSWORD: completalo con el POSTGRES_PASSWORD de ese docker-compose.
# El contenedor NO crea una base llamada "pulse_db"; si necesitás ese nombre,
# creála y ajustá DB_NAME.
DB_HOST=localhost
DB_PORT=5432
DB_USER=pulse
DB_PASSWORD=your_database_password_here
DB_NAME=pulse

# ── JWT ─────────────────────────────────────────────────────
# Clave de firma: completala con un valor largo y aleatorio (igual en ambos backends).
# NUNCA la subas al repo.
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=3600s

# ── Argon2id (perfil OWASP · ver openapi.yaml) ──────────────
# memoryCost en KiB (19456 KiB = 19 MiB), timeCost = iteraciones, parallelism = hilos
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
