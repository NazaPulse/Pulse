# ─────────────────────────────────────────────────────────────
# Pulse — Backend A (NestJS)   ·   Variables de entorno
# Copiá este archivo a `.env` y ajustá los valores.
# ─────────────────────────────────────────────────────────────

# App
PORT=3000
NODE_ENV=development

# ── PostgreSQL ──────────────────────────────────────────────
# Los valores por defecto coinciden con docker-compose.yml de la raíz
# (POSTGRES_USER/PASSWORD/DB => "pulse"). El contenedor NO crea una base
# llamada "pulse_db"; si necesitás ese nombre, creála y ajustá DB_NAME.
DB_HOST=localhost
DB_PORT=5432
DB_USER=pulse
DB_PASSWORD=pulse
DB_NAME=pulse

# ── JWT ─────────────────────────────────────────────────────
# Secreto de firma. NUNCA lo subas al repo. En producción usá un valor largo y aleatorio.
JWT_SECRET=dev-only-change-me-please-use-a-long-random-string
JWT_EXPIRES_IN=3600s

# ── Argon2id (perfil OWASP · ver openapi.yaml) ──────────────
# memoryCost en KiB (19456 KiB = 19 MiB), timeCost = iteraciones, parallelism = hilos
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
