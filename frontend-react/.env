# Vacío en desarrollo => las llamadas usan el mismo origen que el dev server
# y el proxy de Vite las reenvía al backend (sin problemas de CORS).
VITE_API_BASE_URL=

# Destino al que el proxy de Vite reenvía /api/* (Backend A / NestJS).
# Backend B (FastAPI) escucha en http://localhost:8000
VITE_DEV_PROXY_TARGET=http://localhost:3000
